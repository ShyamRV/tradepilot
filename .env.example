# Local development only. Copy to .env; never commit real secrets.
# Production secrets belong in a managed secrets store (Railway/Render/Vault/etc.).

ENVIRONMENT=development
# TRADEPILOT_ENV=production refuses the in-memory AuthProvider — use staging until managed auth is wired.
TRADEPILOT_ENV=development

POSTGRES_DB=tradepilot
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=replace-with-strong-local-password
POSTGRES_PORT=5432

# Preferred durable store for API/worker in Compose/Railway/Render.
# docker-compose.prod.yaml example host: postgres
DATABASE_URL=postgresql://tradepilot:replace-with-strong-local-password@localhost:5432/tradepilot

# Optional SQLite file path when DATABASE_URL is unset (durable local fallback).
# Leave empty when DATABASE_URL (Postgres) is the source of truth.
TRADEPILOT_DB_PATH=

# Comma-separated browser origins allowed to call the API (no trailing slashes).
TRADEPILOT_CORS_ORIGINS=http://localhost:3000

# Per-client HTTP rate limit (requests / rolling 60s) enforced by API middleware.
TRADEPILOT_RATE_LIMIT_PER_MINUTE=120

MINIO_ROOT_USER=tradepilot-local-admin
MINIO_ROOT_PASSWORD=replace-with-at-least-16-characters
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tradepilot-private
S3_ACCESS_KEY=tradepilot-local-admin
S3_SECRET_KEY=replace-with-at-least-16-characters

# Disabled until a licensed provider contract and secrets-manager entry exist.
MARKET_DATA_PROVIDER=unconfigured
MARKET_DATA_API_KEY=
MARKET_DATA_MODE=delayed
MARKET_DATA_DELAY_MINUTES=15

# LLM receives only allowlisted structured fields; never provider/user secrets.
LLM_PROVIDER=unconfigured
LLM_API_KEY=
LLM_MODEL=
LLM_RETENTION_OPT_OUT=true

APP_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Error reporting stub — leave empty until a Sentry (or equivalent) project DSN
# is provisioned in the secrets manager. See docs/monitoring.md.
SENTRY_DSN=

# Owned by the operating entity; store only in secrets manager for production.
TELEGRAM_BOT_TOKEN=
WORKER_POLL_SECONDS=5

# Web (Vercel / local Next.js) — set in the web host env, not required for API:
# NEXT_PUBLIC_API_URL=https://api.example.com
# When unset, apps/web shows the static illustrative demo (not live user data).
# When set, the dashboard calls the FastAPI origin (must also allow CORS above).
