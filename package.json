{
  "name": "tradepilot",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tradepilot/web",
    "build": "npm run build --workspace=@tradepilot/web",
    "typecheck": "npm run typecheck --workspace=@tradepilot/web",
    "lint": "npm run lint --workspace=@tradepilot/web",
    "test": "npm run test --workspace=@tradepilot/web",
    "test:e2e": "npm run test:e2e --workspace=@tradepilot/web",
    "neon:env": "neon env pull",
    "neon:deploy": "neon deploy",
    "api:dev": "neon-env run -- python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --reload"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
