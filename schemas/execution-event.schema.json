{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradepilot.example/schemas/execution-event.schema.json",
  "title": "Append-only sandbox execution event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "order_intent_id", "sequence", "event_type", "occurred_at", "source"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "order_intent_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "intent_created",
        "previewed",
        "confirmed",
        "risk_approved",
        "risk_rejected",
        "queued",
        "submitted",
        "acknowledged",
        "partial_fill",
        "filled",
        "cancel_requested",
        "cancelled",
        "rejected",
        "unknown",
        "reconciled",
        "killed"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["api", "risk", "worker", "broker", "reconciler", "agent", "operator"] },
    "provider_event_id": { "type": ["string", "null"], "maxLength": 128 },
    "payload": { "type": "object" }
  }
}
