{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradepilot.example/schemas/risk-decision.schema.json",
  "title": "Deterministic pre-trade risk decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "order_intent_id", "allowed", "checks", "formula_version", "decided_at"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "order_intent_id": { "type": "string", "minLength": 1 },
    "allowed": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "passed", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "passed": { "type": "boolean" },
          "message": { "type": "string", "maxLength": 500 },
          "actual": { "type": ["string", "null"] },
          "limit": { "type": ["string", "null"] }
        }
      }
    },
    "formula_version": { "type": "string", "minLength": 1 },
    "quote_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
